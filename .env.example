# Copy to .env.local for local development. NEVER commit real secrets.
# Server-only secret used to sign run tokens (HMAC-SHA256). Use 32+ random bytes.
# In AWS: store in Amplify environment secrets / SSM Parameter Store / Secrets Manager.
RUN_TOKEN_SECRET=change-me-to-a-long-random-string

# Deployment stage: development | staging | production
APP_STAGE=development

# DynamoDB table (leave empty to use the in-memory/file store for local dev).
DDB_TABLE_NAME=
AWS_REGION=ap-south-1

# Public (exposed to the browser): optional CDN base for game assets, e.g. https://dxxxx.cloudfront.net
NEXT_PUBLIC_ASSET_BASE_URL=
NEXT_PUBLIC_APP_STAGE=development
